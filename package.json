{
  "name": "ai-video-creation-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "dev:debug-brk": "NODE_OPTIONS='--inspect-brk' next dev",
    "build": "next build",
    "start": "next start",
    "start:debug": "NODE_OPTIONS='--inspect' next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "docker:dev": "docker-compose up app-dev prisma-studio",
    "docker:dev:detached": "docker-compose up -d app-dev prisma-studio",
    "docker:dev:down": "docker-compose down",
    "docker:prod": "docker-compose up --build app",
    "docker:prod:detached": "docker-compose up --build -d app",
    "docker:prod:down": "docker-compose down",
    "docker:studio": "docker-compose up prisma-studio",
    "docker:studio:detached": "docker-compose up -d prisma-studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@prisma/client": "^6.18.0",
    "@types/nodemailer": "^7.0.3",
    "dotenv": "^17.2.3",
    "hls.js": "^1.6.13",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.546.0",
    "next": "14.2.0",
    "nodemailer": "^7.0.10",
    "prisma": "^6.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  }
}
